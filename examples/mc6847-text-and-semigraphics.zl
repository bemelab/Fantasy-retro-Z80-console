; MC6847 VDG: 32x16 text and semigraphics blocks
; vdg m sets the mode pins: bit 0 graphics, bits 1-3 mode, bit 4 color set
vdg 0
cls
vprint 0 0 "MC6847 VIDEO DISPLAY GENERATOR"
vprint 0 2 "32 X 16 TEXT, GREEN ON DARK GREEN"
vprint 0 4 "SEMIGRAPHICS BLOCKS BELOW:"
for c = 0 to 8
  v = c + c
  v = v + v
  v = v + v
  v = v + v
  v = v + 143          ; bit 7 + color + all four quadrants
  a = c + c
  a = a + a
  a = a + 192          ; row 6 starts at $80C0, 4 cells per block
  poke 128 a v
  a = a + 1
  poke 128 a v
  v = v - 5            ; quadrants 1010
  a = a + 1
  poke 128 a v
  a = a + 1
  poke 128 a v
end
label main
  vdg 0
  wait 60
  vdg 16               ; other color set
  wait 60
  goto main
