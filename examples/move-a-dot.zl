; arrow keys move, fire clears
x = 16
y = 16
cls
while 1 == 1
  key k
  d = k & 1
  if d == 1
    x = x - 1
  end
  d = k & 2
  if d == 2
    x = x + 1
  end
  d = k & 4
  if d == 4
    y = y - 1
  end
  d = k & 8
  if d == 8
    y = y + 1
  end
  d = k & 16
  if d == 16
    cls
  end
  x = x & 31
  y = y & 31
  plot x y 11
  wait 3
end
