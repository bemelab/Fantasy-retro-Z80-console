; ALIEN ATTACK
; left/right move, fire shoots. Sounds: shot, hit, march, bomb, win, game over.
; Uses the top-left 64x64 area, so it runs on every display.
dim al 3 8            ; alien alive flags: al[row][col]
score = 0
lives = 3
px = 30
go = 0
wv = 0
sn = 0
t = 0
cls
gosub newwave
gosub hud

label main
  t = t + 1
  key k
  m = t & 1
  if m == 0           ; ship moves every 2nd frame
    c = 0
    gosub ship
    d = k & 1
    if d == 1
      if px > 2
        px = px - 1
      end
    end
    d = k & 2
    if d == 2
      if px < 61
        px = px + 1
      end
    end
  end
  c = 10
  gosub ship
  d = k & 16          ; fire
  if d == 16
    if bon == 0
      bon = 1
      bx = px
      by = 57
      beep 40
    end
  end
  if bon == 1         ; move the shot
    c = 0
    gosub bullet
    by = by - 2
    if by < 11
      bon = 0
    else
      gosub hitcheck
      if bon == 1
        c = 7
        gosub bullet
      end
    end
  end
  fc = fc + 1         ; fleet marches faster as it shrinks
  if fc >= sp
    fc = 0
    gosub step
  end
  if bmo == 0         ; aliens drop one bomb at a time
    d = rnd & 7
    if d == 0
      r = rnd & 3
      q = rnd & 7
      if r < 3
        if q < 6
          if al[r][q] == 1
            gosub pos
            bmx = ax + 1
            bmy = ay + 3
            bmo = 1
          end
        end
      end
    end
  else
    m = t & 1
    if m == 0
      plot bmx bmy 0
      bmy = bmy + 1
      if bmy > 62
        bmo = 0
      else
        if bmy > 59
          e = bmx - px
          e = e + 1
          if e < 3
            bmo = 0
            lives = lives - 1
            beep 4
            gosub hud
            if lives == 0
              go = 1
            end
          end
        end
        if bmo == 1
          plot bmx bmy 12
        end
      end
    end
  end
  if wv == 1
    gosub win
  end
  if go == 1
    gosub over
  end
  wait 1
  goto main

; alien position from row r and column q -> ax, ay
label pos
  cx = q + q
  cx = cx + cx
  cx = cx + cx
  ax = ox + cx
  cy = r + r
  cy = cy + cy
  cy = cy + cy
  ay = oy + cy
  return

; one alien, 3x2 pixels, color c
label alien
  plot ax ay c
  qx = ax + 1
  plot qx ay c
  qx = ax + 2
  plot qx ay c
  qy = ay + 1
  plot ax qy c
  plot qx qy c
  return

label ship
  plot px 60 c
  qx = px - 1
  plot qx 61 c
  plot px 61 c
  qx = px + 1
  plot qx 61 c
  return

label bullet
  plot bx by c
  qy = by + 1
  plot bx qy c
  return

; draw (fe = 1) or erase (fe = 0) the whole fleet
label fleet
  for r = 0 to 3
    for q = 0 to 6
      if al[r][q] == 1
        gosub pos
        c = 0
        if fe == 1
          c = r + 9
        end
        gosub alien
      end
    end
  end
  return

; one march step: sideways, drop at the edge
label step
  fe = 0
  gosub fleet
  if dir == 1
    ox = ox + 2
  else
    ox = ox - 2
  end
  if ox > 20
    if dir == 1
      dir = 255
      ox = 20
    else
      dir = 1
      ox = 0
    end
    oy = oy + 4
  end
  fe = 1
  gosub fleet
  sn = sn + 1
  m = sn & 3
  m = m + m
  m = m + 3
  beep m
  if oy > 38
    go = 1
  end
  return

; does the shot touch an alien?
label hitcheck
  for r = 0 to 3
    for q = 0 to 6
      if bon == 1
        if al[r][q] == 1
          gosub pos
          e = bx - ax
          if e < 3
            e = by - ay
            e = e + 1
            if e < 4
              al[r][q] = 0
              c = 0
              gosub alien
              bon = 0
              score = score + 1
              cnt = cnt - 1
              sp = cnt + 3
              beep 70
              gosub hud
              if cnt == 0
                wv = 1
              end
            end
          end
        end
      end
    end
  end
  return

; score as a hex display, lives as red blocks
label hud
  seg 2 1 11 score
  for i = 0 to 4
    ix = i + i
    ix = ix + ix
    ix = ix + 48
    c = 0
    if i < lives
      c = 8
    end
    plot ix 3 c
    qx = ix + 1
    plot qx 3 c
    plot ix 4 c
    plot qx 4 c
  end
  return

label newwave
  for r = 0 to 3
    for q = 0 to 8
      al[r][q] = 0
      if q < 6
        al[r][q] = 1
      end
    end
  end
  cnt = 18
  ox = 4
  oy = 12
  dir = 1
  fc = 0
  bon = 0
  bmo = 0
  sp = 21
  fe = 1
  gosub fleet
  return

label win
  wv = 0
  for i = 0 to 8
    j = i + i
    j = j + 30
    beep j
    wait 5
  end
  cls
  gosub newwave
  gosub hud
  return

label over
  print 14 28 8 "GAME OVER"
  for i = 0 to 8
    j = i + i
    j = 40 - j
    beep j
    wait 5
  end
  d = 0
  while d == 0        ; press fire to play again
    key k
    d = k & 16
  end
  go = 0
  score = 0
  lives = 3
  px = 30
  cls
  gosub newwave
  gosub hud
  wait 20
  return
