; CHIP SHOWCASE: TMS9918A video + AY-3-8910 sound (pick the TMS9918A display)
; VIDEO: Graphics II (full 256x192), Graphics I, Text 40x24, Multicolor, doubled sprites,
;        collision flag, fifth-sprite flag, status register, backdrop color
; SOUND: 3 tones, noise, mixer, envelope shapes 9/14/12/10, arpeggio, port A keyboard
; Arrow keys (read through AY port A) move the blue diamond.
dim mel 16
dim arp 4
mel[0] = 60
mel[1] = 63
mel[2] = 67
mel[3] = 63
mel[4] = 58
mel[5] = 62
mel[6] = 65
mel[7] = 62
mel[8] = 56
mel[9] = 60
mel[10] = 63
mel[11] = 60
mel[12] = 55
mel[13] = 58
mel[14] = 62
mel[15] = 67
arp[0] = 0
arp[1] = 3
arp[2] = 7
arp[3] = 12
t = 0
st = 0
stg = 0
tf = 0
dc = 0
cd = 0
es = 9
bp = 18
n = 60
x0 = 40
y0 = 40
dx0 = 2
dy0 = 1
x1 = 180
y1 = 120
ay 7 0x38             ; mixer: tones on, noise off
ay 8 16               ; channel A volume from the envelope
ay 9 12
ay 10 9
ay 11 0x80            ; envelope period
ay 12 0x03
vaddr 0x38 0x00       ; sprite patterns at VRAM $3800: ball, diamond
vdata 0x3C
vdata 0x7E
vdata 0xFF
vdata 0xFF
vdata 0xFF
vdata 0xFF
vdata 0x7E
vdata 0x3C
vdata 0x10
vdata 0x38
vdata 0x7C
vdata 0xFE
vdata 0x7C
vdata 0x38
vdata 0x10
vdata 0x00
gosub st0
label main
  t = t + 1
  gosub music
  gosub sprites
  tf = tf + 1
  if tf == 240         ; change video mode every 4 seconds (variables are 8-bit)
    tf = 0
    stg = stg + 1
    stg = stg & 3
    if stg == 0
      gosub st0
    end
    if stg == 1
      gosub st1
    end
    if stg == 2
      gosub st2
    end
    if stg == 3
      gosub st3
    end
  end
  wait 1
  goto main

; ---- sound: lead, bass, arpeggio and noise hi-hat ----
label music
  m = t & 7
  if m == 0
    i = st & 15
    n = mel[i]
    note 0 n           ; lead on channel A
    ay 13 es           ; restart the envelope shape
    m2 = i & 12
    b = mel[m2]
    b = b - 24
    note 1 b           ; bass on channel B
    m2 = i & 3
    if m2 == 2
      ay 7 0x18        ; noise on channel C
      ay 6 6
      dc = 3
    end
    st = st + 1
  end
  m = t & 3
  o = arp[m]
  x = n + o
  note 2 x             ; arpeggio on channel C
  if dc > 0
    dc = dc - 1
    if dc == 0
      ay 7 0x38
      ay 8 16
    end
  end
  if cd > 0
    cd = cd - 1
  end
  return

; noise explosion with envelope decay and a new backdrop color
label boom
  cd = 40
  ay 7 0x07
  ay 6 bp
  ay 13 0
  dc = 14
  r = rnd & 7
  r = r + 2
  vreg 7 r
  return

; ---- sprites: one bounces, one follows the arrows ----
label sprites
  ayget k 14
  d = k & 1
  if d == 1
    x1 = x1 - 2
  end
  d = k & 2
  if d == 2
    x1 = x1 + 2
  end
  d = k & 4
  if d == 4
    y1 = y1 - 2
  end
  d = k & 8
  if d == 8
    y1 = y1 + 2
  end
  x0 = x0 + dx0
  y0 = y0 + dy0
  if x0 > 240
    dx0 = 0 - dx0
    x0 = x0 + dx0
  end
  if y0 > 176
    dy0 = 0 - dy0
    y0 = y0 + dy0
  end
  vaddr 0x1B 0x00      ; sprite attribute table: y, x, pattern, color
  vdata y0
  vdata x0
  vdata 0
  vdata 11
  vdata y1
  vdata x1
  vdata 1
  vdata 5
  if stg == 3          ; six sprites on one line: the fifth-sprite flag
    xx = 30
    for i = 0 to 6
      vdata 150
      vdata xx
      vdata 0
      vdata 15
      xx = xx + 24
    end
  end
  vdata 0xD0           ; end of sprite list
  vstat s              ; status: bit 7 frame, bit 6 fifth sprite, bit 5 collision
  d = s & 96
  if d > 0
    if cd == 0
      gosub boom
    end
  end
  return

; ---- Graphics II: 256x192 bitmap ----
label st0
  es = 9
  bp = 18
  vreg 0 2
  vreg 1 0xE1
  vreg 2 6
  vreg 3 0xFF
  vreg 4 3
  vreg 7 1
  vaddr 0x18 0x00
  for i = 0 to 3
    for j = 0 to 255
      vdata j
    end
    vdata 255
  end
  cls
  for x = 0 to 255
    plot x 0 15
    plot x 191 15
  end
  for y = 0 to 192
    plot 0 y 15
    plot 255 y 15
    plot y y 6
  end
  for c = 1 to 16
    xs = c + c
    xs = xs + xs
    xs = xs + xs
    xs = xs + xs
    for y = 24 to 40
      for k = 0 to 16
        xx = xs + k
        plot xx y c
      end
    end
  end
  return

; ---- Graphics I: 32x24 tiles ----
label st1
  es = 14
  bp = 12
  vreg 0 0
  vreg 1 0xE1
  vreg 2 5
  vreg 3 0x80
  vreg 4 0
  vreg 7 4
  vaddr 0 0
  vfont                ; load the character set into the pattern table
  vaddr 0x20 0x00      ; color table: one byte per 8 characters
  for i = 0 to 32
    c = i & 15
    c = c + c
    c = c + c
    c = c + c
    c = c + c
    c = c + 1
    vdata c
  end
  vaddr 0x14 0x00      ; name table
  vtext "TMS9918A GRAPHICS I MODE 32X24  "
  for i = 0 to 23
    gosub grow
  end
  return
label grow
  vtext "ABCDEFGHIJKLMNOPQRSTUVWXYZ012345"
  return

; ---- Text mode: 40x24, 6x8 cells ----
label st2
  es = 12
  bp = 24
  vreg 0 0
  vreg 1 0xF0
  vreg 2 2
  vreg 4 0
  vreg 7 0xF4
  vaddr 0 0
  vfont
  hi = 8
  lo = 0
  for r = 0 to 24
    vaddr hi lo
    v = r + 48
    vdata v
    gosub trow
    lo = lo + 40
    if lo < 40
      hi = hi + 1
    end
  end
  return
label trow
  vtext " TMS9918A TEXT MODE, 40X24, 6X8 CELLS"
  return

; ---- Multicolor: 64x48 blocks of 4x4 pixels ----
label st3
  es = 10
  bp = 4
  vreg 0 0
  vreg 1 0xE9
  vreg 2 5
  vreg 4 0
  vreg 7 1
  vaddr 0x14 0x00
  for i = 0 to 3
    for j = 0 to 255
      vdata j
    end
    vdata 255
  end
  vaddr 0 0
  for i = 0 to 8
    for j = 0 to 255
      v = rnd
      vdata v
    end
    v = rnd
    vdata v
  end
  return
