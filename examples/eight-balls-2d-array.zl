; 8 balls in one 2D array: ball[i][field]
; fields: 0 = x, 1 = y, 2 = dx, 3 = dy (1 or 255 means -1)
dim ball 8 4
fx = 0
fy = 1
fdx = 2
fdy = 3

; start on a grid with random directions
for i = 0 to 8
  k = i & 3
  x = k + k
  x = x + x
  x = x + x
  x = x + 3
  r = i & 4
  y = r + r
  y = y + y
  y = y + 6
  ball[i][fx] = x
  ball[i][fy] = y
  gosub rdir
  ball[i][fdx] = v
  gosub rdir
  ball[i][fdy] = v
end
cls

label main
  for i = 0 to 8
    px = ball[i][fx]
    py = ball[i][fy]
    plot px py 0
  end
  for i = 0 to 8
    gosub move
  end
  for i = 0 to 8
    px = ball[i][fx]
    py = ball[i][fy]
    c = i + 8
    plot px py c
  end
  wait 5
  goto main

; random direction: v = 1 or 255
label rdir
  r = rnd & 2
  v = r - 1
  return

; move ball i one step; turn only on a wall or ball hit
label move
  nx = ball[i][fx] + ball[i][fdx]
  ny = ball[i][fy] + ball[i][fdy]
  if nx > 31
    if nx == 32
      ball[i][fdx] = 255
    else
      ball[i][fdx] = 1
    end
    gosub rdir
    ball[i][fdy] = v
    return
  end
  if ny > 31
    if ny == 32
      ball[i][fdy] = 255
    else
      ball[i][fdy] = 1
    end
    gosub rdir
    ball[i][fdx] = v
    return
  end
  for j = 0 to 8
    if j != i
      t = nx - ball[j][fx]
      t = t + 1
      if t < 3
        t = ny - ball[j][fy]
        t = t + 1
        if t < 3
          gosub rdir
          ball[i][fdx] = v
          gosub rdir
          ball[i][fdy] = v
          gosub rdir
          ball[j][fdx] = v
          gosub rdir
          ball[j][fdy] = v
          return
        end
      end
    end
  end
  ball[i][fx] = nx
  ball[i][fy] = ny
  return
