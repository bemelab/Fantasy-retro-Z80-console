10 MODE 1:BORDER 0:INK 0,0:INK 1,24:INK 2,6:INK 3,15
20 RANDOMIZE TIME:S=0:L=3:X=18:W=25
30 CLS:PEN 3:LOCATE 1,1:PRINT "SCORE";S;"LIVES";L
40 FX=INT(RND*38)+1:FY=2
60 IF INKEY(8)=0 AND X>2 THEN X=X-1
70 IF INKEY(1)=0 AND X<36 THEN X=X+1
80 PEN 1:LOCATE X-1,24:PRINT " === "
90 LOCATE FX,FY:PRINT " ":FY=FY+1
100 IF FY<24 THEN PEN 2:LOCATE FX,FY:PRINT "O":FOR T=1 TO W*8:NEXT:GOTO 60
120 IF FX>=X AND FX<=X+2 THEN GOSUB 300 ELSE L=L-1:SOUND 1,1000,20
130 IF L=0 THEN 200
140 PEN 3:LOCATE 1,1:PRINT "SCORE";S;"LIVES";L
150 GOTO 40
200 CLS:PEN 3:LOCATE 16,10:PRINT "GAME OVER"
210 LOCATE 16,12:PRINT "SCORE";S
220 LOCATE 8,15:PRINT "PRESS SPACE TO PLAY AGAIN"
230 IF INKEY(47)<>0 THEN 230 ELSE RUN
300 S=S+1:W=W+(W>3):SOUND 1,200,10:RETURN
